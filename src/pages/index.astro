---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalHero from '../components/TerminalHero.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import VerifiedWork from '../components/VerifiedWork.astro';
import RequestTrace from '../components/RequestTrace.astro';
import Manifesto from '../components/Manifesto.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import { TECH_LINKS } from '../data/tech-links';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lastWrite = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
  .format(posts[0].data.pubDate)
  .replaceAll('/', '.');
const stack = [
  ['harmony', ['HarmonyOS NEXT', 'ArkUI', 'ArkTS', 'DevEco Studio']],
  ['language', ['TypeScript', 'Java', 'JavaScript']],
  ['backend', ['Spring Boot', 'MyBatis-Plus', 'Express', 'Prisma', 'MySQL', 'Redis']],
  ['frontend', ['Vue', 'uni-app', 'Astro', 'GSAP']],
  ['infra', ['Linux', 'Docker', 'Nginx', 'Git']]
] as const;

// Decorative hex dump column (build-time generated, aria-hidden).
const hexDump = Array.from({ length: 24 }, (_, row) => {
  const address = (0x7f10 + row * 8).toString(16).padStart(4, '0');
  const bytes = Array.from({ length: 6 }, () => (Math.random() * 256 | 0).toString(16).padStart(2, '0')).join(' ');
  return `${address}  ${bytes}`;
}).join('\n');

// ASCII system panel (open box, spans injected via set:html).
const asciiPanel = [
  '┌─[ <span class="ascii-acid">guest@matcha</span> ]',
  '│ <span class="ascii-key">uptime</span>  : still shipping',
  '│ <span class="ascii-key">runtime</span> : arkts · arkui · api 12',
  '│ <span class="ascii-key">battery</span> : <span class="ascii-accent">caffeine 87%</span> · refilling',
  '└──────────────────────────────────'
].join('\n');
---

<BaseLayout>
  <section class="hero shell" id="top">
    <span class="hero__orb" data-hero-orb aria-hidden="true"></span>
    <span class="hero__hex" aria-hidden="true">{hexDump}</span>

    <div class="hero__copy">
      <p class="path-label path-label--bracket"><span class="path-label__tilde">~</span>/matcha <span class="path-label__branch">main*</span></p>
      <h1 class="hero__title" data-split>{profile.name}<span class="hero__caret" aria-hidden="true">_</span></h1>
      <p class="hero__role"><span aria-hidden="true">$</span> {profile.title} <span>/ Stage model, ArkUI, and real-device debugging</span></p>
      <p class="hero__bio">{profile.bio}</p>
      <div class="hero__meta">
        <span class="hero__status"><i aria-hidden="true"></i>{profile.status}</span>
        <span>last_write <time datetime={posts[0].data.pubDate.toISOString()}>{lastWrite}</time></span>
        <span>utc+8 <time data-local-time>--:--</time></span>
      </div>
      <div class="hero__links">
        {profile.socialLinks.map((link) => (
          <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
            {link.label.toLowerCase()} <span aria-hidden="true">↗</span>
          </a>
        ))}
        <span class="hero__separator" aria-hidden="true">/</span>
        <button type="button" data-qr="/qrcodes/wechat.jpg" data-label="微信" data-shared-id="qr:wechat:trigger">
          <span data-qr-icon class="hero__qr-icon" aria-hidden="true">⌁</span>wechat
        </button>
        <button type="button" data-qr="/qrcodes/qq.png" data-label="QQ" data-shared-id="qr:qq:trigger">
          <span data-qr-icon class="hero__qr-icon" aria-hidden="true">⌁</span>qq
        </button>
      </div>
      <pre class="hero__ascii" aria-hidden="true" set:html={asciiPanel} />
    </div>

    <TerminalHero />
  </section>

  <div class="marquee marquee--tech" data-marquee data-duration="34" aria-hidden="true">
    <div class="marquee__track" data-marquee-track>
      <div class="marquee__group">
        <a href={TECH_LINKS['ArkTS']} target="_blank" rel="noreferrer" tabindex="-1"><span>ArkTS</span></a><i>✳</i>
        <a href={TECH_LINKS['HarmonyOS']} target="_blank" rel="noreferrer" tabindex="-1"><span class="is-outline">HarmonyOS</span></a><i>✳</i>
        <a href={TECH_LINKS['TypeScript']} target="_blank" rel="noreferrer" tabindex="-1"><span>TypeScript</span></a><i>✳</i>
        <a href={TECH_LINKS['Java']} target="_blank" rel="noreferrer" tabindex="-1"><span class="is-outline">Java</span></a><i>✳</i>
        <a href={TECH_LINKS['Spring Boot']} target="_blank" rel="noreferrer" tabindex="-1"><span>Spring Boot</span></a><i>✳</i>
        <a href={TECH_LINKS['MySQL']} target="_blank" rel="noreferrer" tabindex="-1"><span class="is-outline">MySQL</span></a><i>✳</i>
        <a href={TECH_LINKS['Redis']} target="_blank" rel="noreferrer" tabindex="-1"><span>Redis</span></a><i>✳</i>
        <a href={TECH_LINKS['Docker']} target="_blank" rel="noreferrer" tabindex="-1"><span class="is-outline">Docker</span></a><i>✳</i>
      </div>
      <div class="marquee__group">
        <a href={TECH_LINKS['ArkTS']} target="_blank" rel="noreferrer" tabindex="-1"><span>ArkTS</span></a><i>✳</i>
        <a href={TECH_LINKS['HarmonyOS']} target="_blank" rel="noreferrer" tabindex="-1"><span class="is-outline">HarmonyOS</span></a><i>✳</i>
        <a href={TECH_LINKS['TypeScript']} target="_blank" rel="noreferrer" tabindex="-1"><span>TypeScript</span></a><i>✳</i>
        <a href={TECH_LINKS['Java']} target="_blank" rel="noreferrer" tabindex="-1"><span class="is-outline">Java</span></a><i>✳</i>
        <a href={TECH_LINKS['Spring Boot']} target="_blank" rel="noreferrer" tabindex="-1"><span>Spring Boot</span></a><i>✳</i>
        <a href={TECH_LINKS['MySQL']} target="_blank" rel="noreferrer" tabindex="-1"><span class="is-outline">MySQL</span></a><i>✳</i>
        <a href={TECH_LINKS['Redis']} target="_blank" rel="noreferrer" tabindex="-1"><span>Redis</span></a><i>✳</i>
        <a href={TECH_LINKS['Docker']} target="_blank" rel="noreferrer" tabindex="-1"><span class="is-outline">Docker</span></a><i>✳</i>
      </div>
    </div>
  </div>

  <div class="home-grid shell">
    <section class="home-notes" id="posts">
      <div class="section-head">
        <div>
          <p class="path-label"><span class="path-label__tilde">~</span>/notes</p>
          <h2 data-split>最近写过 <span class="section-head__count">{String(posts.length).padStart(2, '0')}</span></h2>
        </div>
        <a href="/posts/" class="section-link">archive/ <span aria-hidden="true">↗</span></a>
      </div>
      <div class="post-list">
        {posts.map((post, index) => <PostCard post={post} index={index} eager={index === 0} />)}
      </div>
    </section>

    <aside class="home-aside">
      <section class="aside-block" data-reveal>
        <header><span>now.md</span><time datetime="2026-10-31">10.31</time></header>
        <p>{profile.now}</p>
        <a href="/now/">read now/ <span aria-hidden="true">→</span></a>
      </section>

      <section class="aside-block" data-reveal>
        <header><span>stack.txt</span><span>{String(profile.tags.length).padStart(2, '0')}</span></header>
        <div class="aside-stack">
          {profile.tags.map((tag) => <a href={TECH_LINKS[tag]} target="_blank" rel="noreferrer">{tag}</a>)}
        </div>
      </section>

      <section class="aside-block aside-block--plain" data-reveal>
        <header><span>local_time</span><span>UTC+8</span></header>
        <p class="aside-clock" data-local-clock>--:--:--</p>
      </section>
    </aside>
  </div>

  <Manifesto />

  <RequestTrace />

  <section class="section shell" id="projects">
    <div class="section-head" data-reveal>
      <div>
        <p class="path-label"><span class="path-label__tilde">~</span>/projects</p>
        <h2 data-split>项目记录</h2>
      </div>
      <p class="section-head__note">selected work / {String(projects.length).padStart(2, '0')} entries</p>
    </div>
    <div class="project-list">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>

  <section class="section shell" id="about">
    <div class="section-head" data-reveal>
      <div>
        <p class="path-label"><span class="path-label__tilde">~</span>/about</p>
        <h2 data-split>工程笔记之外</h2>
      </div>
      <p class="section-head__note">{profile.timezone} · UTC+8</p>
    </div>

    <div class="about-grid">
      <div class="about-copy" data-reveal>
        <p class="about-copy__lead">以 HarmonyOS NEXT / ArkTS 为主栈，Java / Spring Boot 为第二栈；重点关注状态所有权、列表复用与真机渲染一致性。</p>
        <p>本站用于沉淀可复核的工程记录。有据、有径与 MindType 的文件、类名和报错均来自实际代码；未完成真机验证的结论会明确标注，不作推断性表述。项目仓库链接见项目卡片。</p>
        <div class="about-links">
          <a href="https://github.com/2697881905" target="_blank" rel="noreferrer">github/2697881905 ↗</a>
          <a href="mailto:2697889105@qq.com">2697889105@qq.com</a>
        </div>
      </div>
      <VerifiedWork />
    </div>

    <div class="stack-matrix">
      {stack.map(([label, value]) => (
        <div class="stack-row" data-reveal>
          <span>{label}</span>
          <p>
            {value.map((item, index) => (
              <span>{index > 0 ? ' / ' : ''}<a href={TECH_LINKS[item]} target="_blank" rel="noreferrer">{item}</a></span>
            ))}
          </p>
        </div>
      ))}
    </div>
  </section>

  <nav class="section-rail" data-section-rail aria-label="页面章节">
    <span class="section-rail__label">sections</span>
    <a href="#top" data-section-link class="is-active"><span>00</span>top</a>
    <a href="#posts" data-section-link><span>01</span>notes</a>
    <a href="#manifesto" data-section-link><span>02</span>manifesto</a>
    <a href="#trace" data-section-link><span>03</span>trace</a>
    <a href="#projects" data-section-link><span>04</span>projects</a>
    <a href="#about" data-section-link><span>05</span>about</a>
  </nav>
</BaseLayout>
