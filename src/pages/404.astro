---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · 抹茶味的琴" description="这个地址没有页面。">
  <header class="index-header shell">
    <p class="path-label"><span class="path-label__tilde">~</span>/404.md</p>
    <div class="index-header__line">
      <h1 data-split>Page not found</h1>
      <p>404</p>
    </div>
    <p class="index-header__description">这个地址没有页面。可能是旧链接，或者我改过 slug。可以回笔记列表，或用 Ctrl K 搜一下。</p>
  </header>

  <section class="section shell" data-reveal>
    <div class="about-links">
      <a href="/posts/">notes/ <span aria-hidden="true">→</span></a>
      <a href="/now/">now/ <span aria-hidden="true">→</span></a>
      <a href="/">home/ <span aria-hidden="true">→</span></a>
      <button type="button" class="text-button" data-command-open>find a note / ctrl k</button>
    </div>
  </section>
</BaseLayout>
