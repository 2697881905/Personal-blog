---
import '@fontsource/geist/latin-400.css';
import '@fontsource/geist/latin-500.css';
import '@fontsource/geist/latin-600.css';
import '@fontsource/geist/latin-700.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import 'lenis/dist/lenis.css';
import { ViewTransitions } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import profile from '../data/profile.json';
import '../styles/global.css';
import '../styles/mobile.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  published?: string;
  updated?: string;
  tags?: string[];
}

const {
  title = `${profile.name} · ${profile.title}`,
  description = `记录有据、有径与 MindType 的实现细节：ArkTS / HarmonyOS 真机问题、Spring Boot 接口、MySQL 索引与 Redis 边界。`,
  type = 'website',
  image = '/og-image.png',
  published,
  updated,
  tags
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image && Astro.site ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="zh-CN" data-cursor="technical">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#06080d" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="zh_CN" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {published && <meta property="article:published_time" content={published} />}
    {updated && <meta property="article:modified_time" content={updated} />}
    {tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png?v=3" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} · RSS`} href="/rss.xml" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var KEY = 'matcha:theme';
        var read = function () {
          try {
            var stored = localStorage.getItem(KEY);
            return stored === 'light' || stored === 'dark' ? stored : null;
          } catch (error) {
            return null;
          }
        };
        var system = function () {
          return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        };
        var apply = function (theme) {
          root.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#f2f5fa' : '#06080d');
        };
        try {
          localStorage.removeItem('matcha:motion');
        } catch {}
        root.dataset.motion = 'full';
        apply(read() || system());
        document.addEventListener('astro:after-swap', function () {
          apply(read() || system());
        });
        window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', function (event) {
          if (!read()) apply(event.matches ? 'light' : 'dark');
        });
      })();
    </script>
    <ViewTransitions fallback="none" />
  </head>
  <body>
    <div class="crt" aria-hidden="true">
      <span class="crt__beam"></span>
      <span class="crt__noise"></span>
      <span class="crt__vignette"></span>
    </div>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Navbar />
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"><span data-scroll-bar></span></div>
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter name={profile.name} />

    <div class="command-layer" data-command-layer hidden>
      <div class="command-layer__backdrop" data-command-close></div>
      <section
        class="command-palette"
        role="dialog"
        aria-modal="true"
        aria-label="搜索与命令"
      >
        <div class="command-palette__bar">
          <span>fuzzy find</span>
          <button type="button" data-command-close aria-label="关闭命令面板">esc</button>
        </div>
        <label class="command-palette__search">
          <span aria-hidden="true">❯</span>
          <input
            type="text"
            data-command-input
            role="combobox"
            aria-expanded="true"
            aria-controls="command-results"
            aria-autocomplete="list"
            placeholder="find a note, page, or command…"
            autocomplete="off"
            spellcheck="false"
          />
        </label>
        <div class="command-palette__results" id="command-results" data-command-results role="listbox"></div>
        <div class="command-palette__foot">
          <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
          <span><kbd>↵</kbd> open</span>
          <span><kbd>esc</kbd> close</span>
        </div>
      </section>
    </div>

    <script>
      import { initSite, destroySite } from '../scripts/site';
      document.addEventListener('astro:page-load', initSite);
      document.addEventListener('astro:before-swap', destroySite);
    </script>
  </body>
</html>
