---
const stages = [
  { index: '01', name: 'Event', detail: 'PostCard.onClick(handleLike)', kind: 'gesture' },
  { index: '02', name: 'State', detail: 'likeStore: liked false → true', kind: 'mutate' },
  { index: '03', name: 'Diff', detail: 'dirty: like icon + count text', kind: 'minimal' },
  { index: '04', name: 'Build', detail: 'PostCard.build()', kind: 'rerender' },
  { index: '05', name: 'Paint', detail: 'frame committed @ next vsync', kind: 'frame' }
];
---

<section class="trace-section" id="trace" data-trace aria-labelledby="trace-title">
  <div class="trace-sticky">
    <div class="trace-inner shell">
      <header class="trace-head">
        <div>
          <p class="path-label"><span class="path-label__tilde">~</span>/trace <span class="path-label__branch">arkui-render.log</span></p>
          <h2 id="trace-title" data-split>One tap, one repaint.</h2>
        </div>
        <p class="trace-counter" aria-live="polite">
          <span data-trace-index>01</span><span> / 05</span>
          <em data-trace-status>queued</em>
        </p>
      </header>

      <div class="trace-board">
        <div class="trace-track" aria-hidden="true">
          <span class="trace-track__fill" data-trace-fill></span>
          <i class="trace-track__pulse" data-trace-pulse></i>
        </div>

        <ol class="trace-nodes">
          {stages.map((stage, index) => (
            <li class="trace-node" data-trace-node data-stage={index}>
              <span class="trace-node__index">{stage.index}</span>
              <div>
                <h3>{stage.name}</h3>
                <code>{stage.detail}</code>
              </div>
              <small>{stage.kind}</small>
            </li>
          ))}
        </ol>

        <div class="trace-console">
          <div class="trace-console__bar">
            <span>arkui-render.trace</span>
            <span class="trace-console__state"><i></i><span data-trace-console-status>waiting for input</span></span>
          </div>
          <pre><code><span data-trace-line>event       PostCard.onClick → handleLike()</span>
<span data-trace-line>state       <span class="trace-dim">likeStore: liked false → true · count +1</span></span>
<span data-trace-line>diff        <span class="trace-dim">dirty: like icon + count text — no list rebuild</span></span>
<span data-trace-line>build       <span class="trace-dim">PostCard.build()</span></span>
<span data-trace-line>paint       <span class="trace-accent">frame committed @ next vsync</span></span></code></pre>
        </div>
      </div>

      <p class="trace-hint">scroll to render <span aria-hidden="true">↓</span></p>
    </div>
  </div>
</section>
