---
const pathname = Astro.url.pathname;
const links = [
  { href: '/posts/', label: 'notes', active: pathname.startsWith('/posts') },
  { href: '/now/', label: 'now', active: pathname.startsWith('/now') },
  { href: '/#about', label: 'about', active: false }
];
---

<header class="site-nav" data-nav>
  <div class="site-nav__inner shell">
    <a
      href="/"
      class="site-nav__brand"
      aria-label="抹茶味的琴，返回首页"
      data-shared-id="site:brand"
      transition:name="site-brand"
    >
      <span class="site-nav__tilde" aria-hidden="true">~</span>
      <span>/matcha</span>
    </a>

    <nav class="site-nav__links" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={["site-nav__link", { "is-active": link.active }]}
          aria-current={link.active ? 'page' : undefined}
        >/{link.label}</a>
      ))}
    </nav>

    <div class="site-nav__actions">
      <span class="site-nav__status"><i aria-hidden="true"></i>static</span>
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label="切换到浅色显示"
        aria-pressed="false"
        title="切换深浅色"
      >
        <svg class="theme-toggle__sun" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="3.1" stroke="currentColor" stroke-width="1.3" />
          <path
            d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M12.8 3.2l-1.1 1.1M4.3 11.7l-1.1 1.1"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
          />
        </svg>
        <svg class="theme-toggle__moon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M13.1 9.6a5.5 5.5 0 0 1-6.7-6.7 5.5 5.5 0 1 0 6.7 6.7Z"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <button
        type="button"
        class="command-trigger"
        data-command-open
        aria-label="打开搜索与命令面板"
        aria-keyshortcuts="Control+K Meta+K"
      >
        <span class="command-trigger__label">find</span>
        <kbd>ctrl</kbd><kbd>k</kbd>
      </button>
    </div>
  </div>
</header>
